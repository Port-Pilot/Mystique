SCRIPT_DIR = Path(__file__).resolve().parent
DEFAULT_CACHE_DIR = Path.home() / ".cache" / "mystique-compile-check"
DEFAULT_LINUX_REPO_URL = "https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
DEFAULT_BUILD_REPO_DIR = Path.home() / ".cache" / "mystique-compile-check-build-repo"
DEFAULT_BUILD_REPO_URL = "https://github.com/OS3Lab/patch_dataset.git"
SHA_RE = re.compile(r"^[0-9a-fA-F]{7,40}$")
COMMIT_URL_RE = re.compile(r"/commit/([0-9a-fA-F]{7,40})(?:[/?#]|$)")
MAKE_VAR_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")


class InfrastructureError(RuntimeError):
    """The environment could not establish a meaningful compile result."""


class GeneratedPatchError(ValueError):
    """The generated patch itself is definitively invalid for this case."""


@dataclass(frozen=True)
class CommandResult:
    returncode: int
    stdout: str
    stderr: str

    @property
    def output(self) -> str:
        return "\n".join(part for part in (self.stdout, self.stderr) if part)


@dataclass(frozen=True)
class BuildSpec:
    """Everything needed to build one benchmark case, read from build_repo."""

    pc_sha: str
    new_patch_sha: str
    source_path: str
    object_path: str
    config_targets: list[str] = field(default_factory=list)
    compile_vars: dict[str, str] = field(default_factory=dict)

    @property
    def arch_vars(self) -> dict[str, str]:
        """The subset of compile_vars that also matters for kbuild config."""
        return {k: v for k, v in self.compile_vars.items() if k in ("ARCH", "CROSS_COMPILE")}


def run(command: list[str], cwd: Path | None = None, timeout: int | None = 600) -> CommandResult:
    """Run a command without a shell and capture all diagnostic output."""
    try:
        proc = subprocess.run(
            command,
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            text=True,
            errors="replace",
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise InfrastructureError(
            f"command timed out after {timeout}s: {' '.join(command)}"
        ) from exc
    except OSError as exc:
        raise InfrastructureError(f"could not run {command[0]}: {exc}") from exc
    return CommandResult(proc.returncode, proc.stdout, proc.stderr)


def output_tail(result: CommandResult, length: int = 3000) -> str:
    text = result.output.strip()
    return text[-length:] if text else "(command produced no output)"


def extract_sha(commit_url: str) -> str:
    match = COMMIT_URL_RE.search(commit_url or "")
    if not match:
        raise ValueError(f"could not extract a commit SHA from {commit_url!r}")
    return match.group(1).lower()


def object_to_source_path(object_path: str) -> str:
    if not object_path.endswith(".o"):
        raise ValueError(f"build recipe target is not an .o file: {object_path}")
    return object_path[:-2] + ".c"


def validate_relative_repo_path(value: str) -> str:
    path = PurePosixPath(value)
    if not value or path.is_absolute() or ".." in path.parts or "\\" in value:
        raise ValueError(f"unsafe repository path: {value!r}")
    return str(path)


def parse_simple_yaml(text: str) -> dict[str, str]:
    """Parse the flat ``key: value`` lines used in patch_dataset's config.yml.

    This is intentionally not a general YAML parser - the files in this
    dataset are a fixed set of scalar keys with no nesting, lists, or quoting,
    so a real YAML dependency would be more machinery than the format needs.
    """
    result: dict[str, str] = {}
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or ":" not in stripped:
            continue
        key, _, value = stripped.partition(":")
        result[key.strip()] = value.strip()
    return result


def parse_build_script(text: str) -> tuple[list[str], dict[str, str], str]:
    """Parse a patch_dataset ``build.sh``.

    Expected shape (observed for every case in the dataset, but parsed
    generically rather than hardcoded so a differently-worded recipe still
    works):

        make <config-target...>
        make [VAR=value ...] [-j N] <object.o>

    Returns (config_targets, compile_vars, object_path).
    """
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if len(lines) < 2:
        raise InfrastructureError(f"build.sh has fewer than 2 non-blank lines:\n{text!r}")

    config_tokens = lines[0].split()
    if not config_tokens or config_tokens[0] != "make":
        raise InfrastructureError(f"build.sh config line does not start with 'make': {lines[0]!r}")
    config_targets = config_tokens[1:]
    if not config_targets:
        raise InfrastructureError(f"build.sh config line has no target: {lines[0]!r}")

    compile_tokens = lines[-1].split()
    if not compile_tokens or compile_tokens[0] != "make":
        raise InfrastructureError(f"build.sh compile line does not start with 'make': {lines[-1]!r}")

    compile_vars: dict[str, str] = {}
    object_path: str | None = None
    tokens = compile_tokens[1:]
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token == "-j":
            i += 2  # skip the parallelism flag and its value; we set our own
            continue
        match = MAKE_VAR_RE.match(token)
        if match:
            compile_vars[match.group(1)] = match.group(2)
            i += 1
            continue
        object_path = token
        i += 1

    if not object_path or not object_path.endswith(".o"):
        raise InfrastructureError(f"build.sh compile line has no .o target: {lines[-1]!r}")

    return config_targets, compile_vars, validate_relative_repo_path(object_path)


class BuildDatasetRepo:
    """A local clone of patch_dataset, the source of per-case build recipes."""

    def __init__(self, path: Path, repo_url: str):
        self.path = path.resolve()
        self.repo_url = repo_url
        self.bugs_dir = self.path / "fixmorph_bugs"

    def initialize(self, update: bool) -> None:
        if not self.path.exists():
            print(f"[setup] clone build-recipe dataset -> {self.path}")
            self.path.parent.mkdir(parents=True, exist_ok=True)
            result = run(
                ["git", "clone", "--depth=1", self.repo_url, str(self.path)],
                timeout=None,
            )
            if result.returncode != 0:
                raise InfrastructureError(f"could not clone build-recipe dataset:\n{output_tail(result)}")
        elif not (self.path / ".git").exists():
            raise InfrastructureError(f"{self.path} exists and is not a Git repository")
        else:
            actual = run(["git", "remote", "get-url", "origin"], cwd=self.path)
            if actual.returncode != 0 or actual.stdout.strip() != self.repo_url:
                raise InfrastructureError(
                    f"cached build-recipe repo origin is {actual.stdout.strip()!r}, not "
                    f"{self.repo_url!r}; use the original --build-repo-url or a different "
                    "--build-repo"
                )
            if update:
                pulled = run(["git", "pull", "--ff-only"], cwd=self.path, timeout=None)
                if pulled.returncode != 0:
                    raise InfrastructureError(f"could not update build-recipe dataset:\n{output_tail(pulled)}")

        if not self.bugs_dir.is_dir():
            raise InfrastructureError(f"expected fixmorph_bugs/ under {self.path}")

    def load(self, row_id: int) -> BuildSpec:
        folder = self.bugs_dir / str(row_id)
        if not folder.is_dir():
            raise InfrastructureError(f"no build recipe for row id {row_id} (expected {folder})")

        try:
            config_text = (folder / "config.yml").read_text(errors="replace")
        except OSError as exc:
            raise InfrastructureError(f"could not read {folder / 'config.yml'}: {exc}") from exc
        config = parse_simple_yaml(config_text)
        pc_sha = config.get("target_release", "").lower()
        new_patch_sha = config.get("new_patch", "").lower()
        if not SHA_RE.fullmatch(pc_sha) or not SHA_RE.fullmatch(new_patch_sha):
            raise InfrastructureError(
                f"config.yml for row {row_id} has invalid target_release/new_patch: {config}"
            )

        try:
            build_text = (folder / "build.sh").read_text(errors="replace")
        except OSError as exc:
            raise InfrastructureError(f"could not read {folder / 'build.sh'}: {exc}") from exc
        config_targets, compile_vars, object_path = parse_build_script(build_text)

        return BuildSpec(
            pc_sha=pc_sha,
            new_patch_sha=new_patch_sha,
            source_path=validate_relative_repo_path(object_to_source_path(object_path)),
            object_path=object_path,
            config_targets=config_targets,
            compile_vars=compile_vars,
        )


def patch_paths(patch_text: str) -> set[str]:
    """Return normalized paths from all file headers in a unified diff."""
    paths: set[str] = set()
    for line in patch_text.splitlines():
        if not (line.startswith("--- ") or line.startswith("+++ ")):
            continue
        value = line[4:].split("\t", 1)[0].strip()
        if value == "/dev/null":
            raise GeneratedPatchError(
                "generated patch creates or deletes the benchmark source file"
            )
        if value.startswith(("a/", "b/")):
            value = value[2:]
        try:
            paths.add(validate_relative_repo_path(value))
        except ValueError as exc:
            raise GeneratedPatchError(str(exc)) from exc
    if not paths:
        raise GeneratedPatchError("generated patch has no unified-diff file headers")
    return paths


def assert_patch_targets(patch_text: str, expected_source_path: str) -> None:
    paths = patch_paths(patch_text)
    if paths != {expected_source_path}:
        raise GeneratedPatchError(
            f"generated patch targets {sorted(paths)!r}; expected only {expected_source_path!r}"
        )


class KernelWorkspace:
    """A bounded, script-owned clone/worktree/build workspace."""

    MARKER = ".mystique-compile-check-owned"

    def __init__(self, cache_dir: Path, repo_url: str):
        self.cache_dir = cache_dir.resolve()
        self.repo_url = repo_url
        self.clone_dir = self.cache_dir / "linux-bare.git"
        self.worktree = self.cache_dir / "worktree"
        self.build_dir = self.cache_dir / "build"

    def initialize(self) -> None:
        self.cache_dir.mkdir(parents=True, exist_ok=True)
        marker = self.cache_dir / self.MARKER
        existing = [entry for entry in self.cache_dir.iterdir() if entry.name != self.MARKER]
        if not marker.exists() and existing:
            raise InfrastructureError(
                f"refusing to use non-empty unowned cache directory {self.cache_dir}"
            )
        marker.touch(exist_ok=True)

        if not self.clone_dir.exists():
            print(f"[setup] initialize bare object store -> {self.clone_dir}")
            result = run(["git", "init", "--bare", str(self.clone_dir)])
            if result.returncode != 0:
                raise InfrastructureError(f"Git repository initialization failed:\n{output_tail(result)}")
            result = run(
                ["git", "remote", "add", "origin", self.repo_url],
                cwd=self.clone_dir,
            )
            if result.returncode != 0:
                raise InfrastructureError(f"could not configure Linux remote:\n{output_tail(result)}")
        elif not (self.clone_dir / "HEAD").exists():
            raise InfrastructureError(f"clone path is not a bare Git repository: {self.clone_dir}")
        else:
            actual = run(["git", "remote", "get-url", "origin"], cwd=self.clone_dir)
            if actual.returncode != 0 or actual.stdout.strip() != self.repo_url:
                raise InfrastructureError(
                    f"cached clone origin is {actual.stdout.strip()!r}, not {self.repo_url!r}; "
                    "use the original --repo-url or a different --cache-dir"
                )

    def ensure_commit(self, sha: str) -> None:
        result = run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=self.clone_dir)
        if result.returncode == 0:
            return
        fetched = run(
            ["git", "fetch", "--depth=1", "--no-tags", "origin", sha],
            cwd=self.clone_dir,
            timeout=None,
        )
        if fetched.returncode != 0:
            raise InfrastructureError(f"could not fetch Pc {sha}:\n{output_tail(fetched)}")
        verified = run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=self.clone_dir)
        if verified.returncode != 0:
            raise InfrastructureError(f"fetched object is not a commit: {sha}")

    def checkout(self, sha: str) -> None:
        self.ensure_commit(sha)
        if not self.worktree.exists():
            run(["git", "worktree", "prune"], cwd=self.clone_dir)
            result = run(
                ["git", "worktree", "add", "--detach", str(self.worktree), sha],
                cwd=self.clone_dir,
                timeout=None,
            )
            if result.returncode != 0:
                raise InfrastructureError(f"worktree creation failed:\n{output_tail(result)}")
        else:
            inside = run(["git", "rev-parse", "--is-inside-work-tree"], cwd=self.worktree)
            if inside.returncode != 0 or inside.stdout.strip() != "true":
                raise InfrastructureError(f"cache worktree path is not a Git worktree: {self.worktree}")
            self.restore()
            result = run(["git", "checkout", "--detach", "--force", sha], cwd=self.worktree, timeout=None)
            if result.returncode != 0:
                raise InfrastructureError(f"checkout of Pc {sha} failed:\n{output_tail(result)}")
        self._clear_build_dir()

    def restore(self) -> None:
        reset = run(["git", "reset", "--hard", "HEAD"], cwd=self.worktree)
        clean = run(["git", "clean", "-fdx"], cwd=self.worktree)
        if reset.returncode != 0 or clean.returncode != 0:
            detail = output_tail(reset if reset.returncode else clean)
            raise InfrastructureError(f"could not clean the dedicated worktree:\n{detail}")

    def _clear_build_dir(self) -> None:
        if self.build_dir.exists():
            shutil.rmtree(self.build_dir)
        self.build_dir.mkdir(parents=True)

    def cleanup_row(self) -> None:
        try:
            if self.worktree.exists():
                self.restore()
        finally:
            self._clear_build_dir()


def docker_wrap(command: list[str], workspace: KernelWorkspace, image: str) -> list[str]:
    """Wrap *command* in a ``docker run`` invocation that mounts the cache
    directory (which contains both the worktree and the build directory) and
    sets the working directory to the checked-out worktree.

    The container is run as the current user so that any files written by the
    build step are owned by the caller, not root.
    """
    uid = os.getuid()
    gid = os.getgid()
    return [
        "docker", "run", "--rm",
        "--user", f"{uid}:{gid}",
        "--volume", f"{workspace.cache_dir}:{workspace.cache_dir}",
        "--workdir", str(workspace.worktree),
        image,
    ] + command


def make_command(build_dir: Path, extra_vars: dict[str, str], targets: list[str]) -> list[str]:
    cmd = ["make", f"O={build_dir}"]
    cmd.extend(f"{key}={value}" for key, value in extra_vars.items())
    cmd.extend(targets)
    return cmd


def disable_retpoline(workspace: KernelWorkspace, timeout: int, image: str | None) -> None:
    """Force CONFIG_RETPOLINE off after kbuild config.

    gcc-4.7 predates retpoline support entirely (it landed in gcc ~7.3 for
    the Spectre v2 mitigation), but kernels from ~4.15 onward set
    CONFIG_RETPOLINE=y by default under allyesconfig and arch/x86/Makefile
    hard-fails the build ("You are building kernel with non-retpoline
    compiler") when the compiler can't do it. The dataset's build.sh recipes
    don't address this, so we do: this only affects a Spectre hardening
    knob, not the plausibility of the object we're actually checking. A
    no-op on kernels/config trees that never had this symbol.
    """
    script = workspace.worktree / "scripts" / "config"
    config_path = workspace.build_dir / ".config"
    if not script.is_file() or not config_path.is_file():
        return
    cmd = ["scripts/config", "--file", str(config_path), "--disable", "RETPOLINE"]
    if image:
        cmd = docker_wrap(cmd, workspace, image)
    result = run(cmd, cwd=workspace.worktree, timeout=timeout)
    if result.returncode != 0:
        # Not fatal on its own - if the symbol genuinely doesn't exist in
        # this kernel's Kconfig some versions of scripts/config still exit
        # 0, but be tolerant either way and let the actual build step be the
        # real judge of whether anything is still broken.
        print(f"[warn] scripts/config --disable RETPOLINE: {output_tail(result)}")

    # kbuild only regenerates include/config/auto.conf (the file that
    # actually feeds CONFIG_RETPOLINE into arch/x86/Makefile) when it
    # notices .config is newer than auto.conf. That's a timestamp
    # comparison, and the edit above plus the next `make` invocation can
    # land in the same filesystem mtime tick, in which case kbuild silently
    # keeps using the stale (retpoline-enabled) auto.conf. Deleting the
    # derived files removes the race entirely: kbuild then has no choice
    # but to regenerate them from the edited .config on the next `make`.
    for stale in (
        workspace.build_dir / "include" / "config" / "auto.conf",
        workspace.build_dir / "include" / "config" / "auto.conf.cmd",
        workspace.build_dir / "include" / "config" / "tristate.conf",
        workspace.build_dir / "include" / "generated" / "autoconf.h",
    ):
        try:
            stale.unlink()
        except FileNotFoundError:
            pass


def configure_kernel(
    workspace: KernelWorkspace,
    spec: BuildSpec,
    timeout: int,
    image: str | None,
) -> None:
    # build.sh's config line (e.g. "allyesconfig") already includes whatever
    # kbuild needs for a single-object build afterwards; no extra "prepare"
    # step is required or present in the dataset's recipes.
    cmd = make_command(workspace.build_dir, spec.arch_vars, spec.config_targets)
    if image:
        cmd = docker_wrap(cmd, workspace, image)
    result = run(cmd, cwd=workspace.worktree, timeout=timeout)
    if result.returncode != 0:
        raise InfrastructureError(
            f"kernel config {' '.join(spec.config_targets)} failed:\n{output_tail(result)}"
        )
    disable_retpoline(workspace, timeout, image)


def remove_object_outputs(build_dir: Path, object_path: str) -> None:
    target = build_dir / object_path
    candidates = [
        target,
        target.parent / f".{target.name}.cmd",
        target.with_suffix(target.suffix + ".d"),
    ]
    for candidate in candidates:
        try:
            candidate.unlink()
        except FileNotFoundError:
            pass


def compile_object(
    workspace: KernelWorkspace,
    spec: BuildSpec,
    timeout: int,
    image: str | None,
) -> tuple[bool, str]:
    remove_object_outputs(workspace.build_dir, spec.object_path)
    cmd = make_command(workspace.build_dir, spec.compile_vars, ["-j", str(os.cpu_count() or 1), spec.object_path])
    if image:
        cmd = docker_wrap(cmd, workspace, image)
    result = run(cmd, cwd=workspace.worktree, timeout=timeout)
    object_file = workspace.build_dir / spec.object_path
    success = result.returncode == 0 and object_file.is_file() and object_file.stat().st_size > 0
    if result.returncode == 0 and not success:
        detail = f"make exited successfully but did not produce {object_file}"
    else:
        detail = output_tail(result)
    return success, detail


def apply_patch(worktree: Path, patch_text: str, timeout: int) -> tuple[bool, str]:
    patch_name: str | None = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".patch", delete=False) as handle:
            handle.write(patch_text)
            patch_name = handle.name
        check = run(
            ["git", "apply", "--check", "--recount", patch_name],
            cwd=worktree,
            timeout=timeout,
        )
        if check.returncode != 0:
            return False, output_tail(check)
        applied = run(
            ["git", "apply", "--recount", "--whitespace=nowarn", patch_name],
            cwd=worktree,
            timeout=timeout,
        )
        return applied.returncode == 0, output_tail(applied)
    finally:
        if patch_name:
            try:
                os.unlink(patch_name)
            except FileNotFoundError:
                pass


def fetch_rows(
    dsn: str, method: str | None, limit: int | None, ids: list[int] | None
) -> list[dict]:
    where = "generated_patch IS NOT NULL AND btrim(generated_patch) <> ''"
    params: list[object] = []
    if method:
        where += " AND method = %s"
        params.append(method)
    if ids:
        where += " AND id = ANY(%s)"
        params.append(ids)
    limit_clause = ""
    if limit is not None:
        limit_clause = " LIMIT %s"
        params.append(limit)
    query = (
        "SELECT id, new_version_patch_commit_url, old_version_patch_commit_url, "
        f"generated_patch FROM backport_benchmark_results WHERE {where} "
        f"ORDER BY id{limit_clause}"
    )
    with psycopg2.connect(dsn) as connection:
        with connection.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cursor:
            cursor.execute(query, params)
            return list(cursor.fetchall())


def update_compilation_result(dsn: str, row_id: int, success: bool) -> None:
    with psycopg2.connect(dsn) as connection:
        with connection.cursor() as cursor:
            cursor.execute(
                "UPDATE backport_benchmark_results "
                "SET compilation_success = %s, updated_at = NOW() WHERE id = %s",
                (success, row_id),
            )
            if cursor.rowcount != 1:
                raise InfrastructureError(
                    f"expected to update one database row for id={row_id}, updated {cursor.rowcount}"
                )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Compile-check generated FixMorph-benchmark patches and update Neon"
    )
    parser.add_argument(
        "--dsn",
        help="Postgres DSN (default: NEON_DATABASE_URL from the environment/.env)",
    )
    parser.add_argument("--method", help="only process rows with this exact method")
    parser.add_argument("--limit", type=int, help="process at most N rows, ordered by id")
    parser.add_argument(
        "--ids",
        help="only process these row ids, e.g. --ids 94,100,177 (combine with --limit to cap them)",
    )
    parser.add_argument("--cache-dir", type=Path, default=DEFAULT_CACHE_DIR)
    parser.add_argument("--repo-url", default=DEFAULT_LINUX_REPO_URL, help="Linux kernel Git remote")
    parser.add_argument(
        "--build-repo",
        type=Path,
        default=DEFAULT_BUILD_REPO_DIR,
        help="local clone of the patch_dataset build-recipe repo",
    )
    parser.add_argument(
        "--build-repo-url",
        default=DEFAULT_BUILD_REPO_URL,
        help="Git remote for the build-recipe repo",
    )
    parser.add_argument(
        "--update-build-repo",
        action="store_true",
        help="git pull the build-recipe repo before running",
    )
    parser.add_argument(
        "--docker-image",
        help=(
            "Docker image providing the toolchain build.sh expects (e.g. gcc-4.7 as the "
            "default cc). Every case in the dataset uses the same toolchain, so one image "
            "covers the whole run. Omitted: builds run directly on the host."
        ),
    )
    parser.add_argument("--build-timeout", type=int, default=1800, metavar="SECONDS")
    parser.add_argument("--apply-timeout", type=int, default=60, metavar="SECONDS")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="perform checkouts/builds and report results without database updates",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    load_dotenv(SCRIPT_DIR / ".env")
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.limit is not None and args.limit <= 0:
        parser.error("--limit must be greater than zero")
    if args.build_timeout <= 0 or args.apply_timeout <= 0:
        parser.error("timeouts must be greater than zero")

    ids: list[int] | None = None
    if args.ids:
        try:
            ids = [int(part) for part in args.ids.split(",") if part.strip()]
        except ValueError:
            parser.error(f"--ids must be a comma-separated list of integers, got {args.ids!r}")
        if not ids:
            parser.error("--ids was given but contained no row ids")

    dsn = args.dsn or os.getenv("NEON_DATABASE_URL")
    if not dsn:
        parser.error("provide --dsn or set NEON_DATABASE_URL")

    try:
        rows = fetch_rows(dsn, args.method, args.limit, ids)
    except Exception as exc:
        print(f"[fatal] database read failed: {exc}", file=sys.stderr)
        return 2

    print(f"[main] selected {len(rows)} generated patches")
    if not rows:
        return 0

    build_repo = BuildDatasetRepo(args.build_repo, args.build_repo_url)
    workspace = KernelWorkspace(args.cache_dir, args.repo_url)
    try:
        build_repo.initialize(args.update_build_repo)
        workspace.initialize()
    except InfrastructureError as exc:
        print(f"[fatal] {exc}", file=sys.stderr)
        return 2

    counts = {"passed": 0, "failed": 0, "inconclusive": 0, "db_errors": 0}
    for row in rows:
        row_id = row["id"]
        definitive: bool | None = None
        try:
            spec = build_repo.load(row_id)

            # Sanity check: row id -> build_repo folder is a positional
            # mapping, not a content-derived one, so cross-check it against
            # the DB row's own recorded Pb commit before trusting Pc/object.
            expected_pb = extract_sha(row["new_version_patch_commit_url"])
            if expected_pb != spec.new_patch_sha:
                raise InfrastructureError(
                    f"row {row_id}: DB Pb={expected_pb[:12]} does not match build-recipe "
                    f"new_patch={spec.new_patch_sha[:12]}; row-id/build-recipe mapping may "
                    "be misaligned"
                )

            assert_patch_targets(row["generated_patch"], spec.source_path)

            print(
                f"[row {row_id}] Pc={spec.pc_sha[:12]} target={spec.object_path} "
                f"config={' '.join(spec.config_targets)} vars={spec.compile_vars}"
            )
            workspace.checkout(spec.pc_sha)
            configure_kernel(workspace, spec, args.build_timeout, args.docker_image)

            baseline_ok, baseline_detail = compile_object(
                workspace, spec, args.build_timeout, args.docker_image
            )
            if not baseline_ok:
                raise InfrastructureError(
                    "unpatched baseline target did not compile; result is inconclusive:\n"
                    + baseline_detail
                )

            applied, apply_detail = apply_patch(
                workspace.worktree, row["generated_patch"], args.apply_timeout
            )
            if not applied:
                print(f"[row {row_id}] FAIL: generated patch does not apply\n{apply_detail}")
                definitive = False
            else:
                patched_ok, patched_detail = compile_object(
                    workspace, spec, args.build_timeout, args.docker_image
                )
                definitive = patched_ok
                if patched_ok:
                    print(f"[row {row_id}] PASS: patched object compiled")
                else:
                    print(f"[row {row_id}] FAIL: patched object did not compile\n{patched_detail}")

        except GeneratedPatchError as exc:
            # Malformed/misdirected generated output is a definitive non-plausible patch.
            print(f"[row {row_id}] FAIL: {exc}")
            definitive = False
        except ValueError as exc:
            counts["inconclusive"] += 1
            print(f"[row {row_id}] INCONCLUSIVE: invalid metadata: {exc}", file=sys.stderr)
        except InfrastructureError as exc:
            counts["inconclusive"] += 1
            print(f"[row {row_id}] INCONCLUSIVE: {exc}", file=sys.stderr)
        except Exception as exc:
            counts["inconclusive"] += 1
            print(f"[row {row_id}] INCONCLUSIVE: unexpected error: {exc}", file=sys.stderr)
        finally:
            try:
                workspace.cleanup_row()
            except Exception as exc:
                print(f"[row {row_id}] warning: cleanup failed: {exc}", file=sys.stderr)

        if definitive is None:
            continue
        counts["passed" if definitive else "failed"] += 1
        if args.dry_run:
            print(f"[row {row_id}] DRY RUN: database not updated")
            continue
        try:
            update_compilation_result(dsn, row_id, definitive)
            print(f"[row {row_id}] database compilation_success={definitive}")
        except Exception as exc:
            counts["db_errors"] += 1
            print(f"[row {row_id}] DATABASE ERROR: {exc}", file=sys.stderr)

    print(
        "[summary] "
        f"passed={counts['passed']} failed={counts['failed']} "
        f"inconclusive={counts['inconclusive']} db_errors={counts['db_errors']}"
    )
    return 1 if counts["inconclusive"] or counts["db_errors"] else 0


if __name__ == "__main__":
    raise SystemExit(main())